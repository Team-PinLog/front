# All VITE_* entries are public build configuration embedded in the browser bundle.
# Copy to .env for local development only; .env is gitignored. Deployment values
# come from GitHub Actions Variables, not GitHub/Kubernetes Secrets.
VITE_API_BASE_URL=/api/core/v1

# 카카오 개발자 콘솔 앱 키. 프론트가 BFF 경유 없이 직접 호출한다(docs/api-contract.md Place·지도·검색).
# 브라우저에 공개되므로 보안은 카카오 콘솔의 플랫폼(도메인) 등록과 최소 권한에 의존한다.
VITE_KAKAO_REST_KEY=
VITE_KAKAO_JS_KEY=
